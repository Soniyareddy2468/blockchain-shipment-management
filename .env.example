# Runtime
NODE_ENV=production
PORT=3000

# Required in production. Generate a unique high-entropy secret and keep it outside Git.
JWT_SECRET=replace-with-a-long-random-secret

# SQLite database. In production, place this on persistent storage.
DB_FILE=./data/shipchain.db

# Comma-separated browser origins allowed by production CORS.
CORS_ORIGINS=https://shipchain.example.com

# Optional JSON request body limit.
JSON_BODY_LIMIT=12mb

# Optional blockchain configuration
# BLOCKCHAIN_RPC_URL=https://...
# BLOCKCHAIN_PRIVATE_KEY=...
# CONTRACT_ADDRESS=0x...
# CONTRACT_ABI=[...]