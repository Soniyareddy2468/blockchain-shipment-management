{
  "name": "shipchain",
  "version": "1.0.0",
  "private": true,
  "description": "ShipChain blockchain shipment management platform",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "chain:node": "hardhat node",
    "chain:compile": "hardhat compile",
    "chain:deploy": "hardhat run scripts/deploy.js --network localhost",
    "test": "jest --config tests/jest.config.js --runInBand",
    "test:integration": "jest --config tests/jest.config.js --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "hardhat": "^2.29.1",
    "jest": "^30.1.3",
    "supertest": "^7.1.4"
  }
}
